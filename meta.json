{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:zed",
  "visibility": "public",
  "url": "https://github.com/viam-labs/zed",
  "description": "C++ camera module for Stereolabs ZED cameras",
  "models": [
    {
      "api": "rdk:component:camera",
      "model": "viam:zed:zed2i",
      "markdown_link": "README.md#model-viamzedzed2i",
      "short_description": "Stereolabs ZED 2i driver: RGB, depth, and pointclouds"
    },
    {
      "api": "rdk:service:discovery",
      "model": "viam:zed:discovery",
      "markdown_link": "README.md#model-viamzeddiscovery",
      "short_description": "Discovery service for connected Stereolabs ZED cameras"
    }
  ],
  "entrypoint": "viam-camera-zed",
  "first_run": "./first_run.sh",
  "build": {
    "setup": "make setup",
    "build": "make module.tar.gz",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
